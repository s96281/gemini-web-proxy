# 必填：至少 16 字元，請自行產生隨機值。
GP_API_KEY=replace-with-a-long-random-secret
GP_COOKIE_FILE=state/cookies.json
GP_COOKIE_CACHE=state/cookie-cache
GP_CONVERSATION_FILE=state/conversations.json
GP_MAX_CONVERSATIONS=256
GP_BROWSER_PROFILE=state/browser
GP_BROWSER_ENABLED=true
GP_BROWSER_HEADLESS=true
# 精確對應自己帳號的模型 ID 與網頁選單標籤；以下只是格式範例，非通用對應。
GP_BROWSER_MODEL_MAP={}
# GP_BROWSER_SELECTORS_FILE=selectors.json
# GP_BROWSER_EXECUTABLE=/usr/bin/chromium
# GP_UPSTREAM_PROXY=http://127.0.0.1:7890
GP_REQUEST_TIMEOUT=300
GP_PREFLIGHT_TIMEOUT=30
GP_QUEUE_TIMEOUT=30
GP_MAX_QUEUE=8
GP_MAX_REQUEST_BYTES=32000000
GP_MAX_IMAGES=8
GP_MAX_IMAGE_BYTES=10000000
GP_MAX_TOTAL_IMAGE_BYTES=20000000
GP_MAX_OUTPUT_CHARS=1000000
# Linux 主機已建立 state 時，可填入 id -u / id -g 的結果供 Compose 使用。
# LOCAL_UID=1000
# LOCAL_GID=1000

# 允許存取 API 的瀏覽器前端來源（JSON 陣列）。
GP_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
